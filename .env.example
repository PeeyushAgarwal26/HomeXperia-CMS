APP_ENV=development
APP_NAME=homexperia-admin-api
APP_VERSION=0.1.0
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8080

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/homexperia_db

SECRET_KEY=change-me-in-every-environment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS_RAW=http://localhost:5173
FRONTEND_URL=http://localhost:5173

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=HomeXperia Admin

# UPLOADS_DIR is where files actually live on disk — in production, point
# this at an absolute path on a persistent volume OUTSIDE the deployment
# directory (e.g. /var/homexperia/uploads), so uploads survive a redeploy.
# UPLOADS_URL_PREFIX is the URL path clients fetch files under and should
# always stay "uploads" regardless of what UPLOADS_DIR is set to.
UPLOADS_DIR=uploads
UPLOADS_URL_PREFIX=uploads
LOG_DIR=logs

# Room visualizer (ported from the client's Flask backend) — outbound calls to
# third-party services, so these stay static API keys (not JWT) regardless of
# how customers authenticate to us.
SAM_API_URL=
SAM_API_KEY=
# Local checkpoint for the room-segmentation pipeline's occluder-refinement
# model (SAM-HQ ViT-B). Not bundled with the segment-anything-hq package —
# download once from https://huggingface.co/lkeab/hq-sam/resolve/main/sam_hq_vit_b.pth
# into this path (or wherever you point this setting).
SAM_HQ_CHECKPOINT_PATH=data/models/sam_hq_vit_b.pth
OPENAI_API_KEY=
VISUALIZER_DEBUG_IMAGES=false
VISUALIZER_SERVICE_KEY=change-me-shared-secret-for-anonymous-embed-callers
