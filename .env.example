APP_ENV=development
APP_NAME=homexperia-admin-api
APP_VERSION=0.1.0
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8080

DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/homexperia_db

SECRET_KEY=change-me-in-every-environment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30

CORS_ORIGINS_RAW=http://localhost:5173
FRONTEND_URL=http://localhost:5173

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=HomeXperia Admin

UPLOADS_DIR=uploads
LOG_DIR=logs
